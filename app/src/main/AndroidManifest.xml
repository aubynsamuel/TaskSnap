<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Feature 1: Call Detection Permissions -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Foreground Service Permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notification Permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot Receiver - Auto-start service when device boots -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Overlay Permission - Display popup over other apps (Truecaller-style) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Battery Optimization - Keep service running reliably -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".TaskSnapApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaskSnap">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TaskSnap">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 
        Feature 2: Text Selection & Share Integration Activity
        
        This activity handles:
        1. ACTION_PROCESS_TEXT - Shows "TaskSnap" in text selection menu
        2. ACTION_SEND - Shows "TaskSnap" in share sheet
        -->
        <activity
            android:name=".taskActivities.ProcessTextActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="TaskSnap"
            android:taskAffinity=""
            android:theme="@style/Theme.TaskSnap.Transparent">

            <!-- Text Selection Menu Integration (Android 6+) -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Share Sheet Integration -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>

        </activity>

        <activity
            android:name=".taskActivities.CallEndedOverlayActivity"
            android:theme="@style/Theme.TaskSnap.OverlayDialog"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <!-- 
        Feature 1: Call Monitor Foreground Service
        This service runs in foreground to reliably detect call state changes.
        Required for Android 10+ due to background execution limits.
        -->
        <service
            android:name=".data.service.CallMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="call_monitoring" />
        </service>

        <!--
        Boot Receiver - Automatically starts the service when device boots.
        This enables Truecaller-style behavior (no need to manually open app).
        -->
        <receiver
            android:name=".data.receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
        Call State Receiver - Detects incoming/outgoing calls and starts the service
        IMPORTANT: On Android 9+, PHONE_STATE broadcasts don't work from manifest alone.
        The service registers this dynamically at runtime.
        This manifest entry is kept for older Android versions.
        -->
        <receiver
            android:name=".data.receiver.CallReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>